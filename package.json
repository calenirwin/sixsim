{
  "name": "valdrada",
  "version": "0.5.0",
  "private": true,
  "description": "Toronto city simulation using the Valdrada framework",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "n8ao": "^2.0.1",
    "playwright": "^1.62.1",
    "postprocessing": "^6.39.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "scripts": {
    "sim:toronto": "node tools/toronto/simulate.mjs",
