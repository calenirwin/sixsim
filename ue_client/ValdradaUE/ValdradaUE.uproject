		{ "Name": "EditorScriptingUtilities", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "MovieRenderPipeline", "Enabled": false },
		{ "Name": "AndroidFileServer", "Enabled": false }
	],
	"TargetPlatforms": [ "Linux", "Windows" ]
}
