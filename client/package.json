{
  "name": "valdrada",
  "version": "1.0.0",
  "description": "Valdrada - photorealistic, real-data NYC digital twin for public-facing simulation",
  "main": "index.js",
  "scripts": {
    "test": "node tools/tests/geometry.mjs",
    "dev": "vite",
    "build": "vite build",
    "fetch": "node tools/pipeline/fetch.mjs",
    "compile": "node --max-old-space-size=24576 tools/pipeline/compile.mjs",
    "shot": "node tools/shot.mjs",
    "dev:fixture": "vite --config vite.fixture.config.js --open /fixture.html",
    "build:fixture": "vite build --config vite.fixture.config.js",
    "test:fixture": "npm run build:fixture && node tools/tests/fixture.mjs",
    "compile:toronto": "node tools/toronto/compile.mjs",
    "dev:toronto": "npm run compile:toronto && vite --config vite.toronto.config.js --open /toronto.html",
    "build:toronto": "npm run compile:toronto && vite build --config vite.toronto.config.js && node tools/toronto/package.mjs",
    "test:toronto": "node --test tools/tests/toronto.mjs",
    "test:toronto:browser": "npm run build:toronto && node tools/tests/toronto-browser.mjs",
    "test:toronto:delivery": "node --test tools/tests/toronto-delivery.mjs",
    "test:toronto:static": "npm run build:toronto && node tools/tests/toronto-static.mjs",
    "test:toronto:repro": "node tools/tests/toronto-repro.mjs",
    "test:transit": "python3 tools/transit/test_extract.py && node --test tools/tests/transit.mjs",
    "test:transit:browser": "npm run build:toronto && node tools/tests/transit-browser.mjs",
    "review:toronto": "npm run compile:toronto && vite --config vite.toronto.config.js --open /corridor.html",
    "prepare:toronto-renderer": "node ../tools/toronto/renderTracks.mjs",
    "prebuild": "npm run prepare:toronto-renderer",
    "dev:city": "npm run prepare:toronto-renderer && vite --open /?city=toronto",
    "test:city:browser": "npm run build && node tools/tests/city-browser.mjs",
    "build:publish": "npm run prepare:toronto-renderer && vite build --config vite.publish.config.js",
    "test:publish": "node tools/tests/publish-browser.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "earcut": "^3.2.3",
    "pngjs": "^7.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.3.0",
    "vite": "^8.1.3"
  }
}
